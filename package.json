{
  "name": "blau",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "bun run cf-typegen && opennextjs-cloudflare build",
    "build:next": "next build",
    "check": "bun run cf-typegen && next typegen && tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "test": "bun test ./tests",
    "test:mount": "bun scripts/verify-shortreel.mjs",
    "test:apps": "bun scripts/verify-apps.mjs",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "deploy:list": "wrangler deployments list",
    "rollback": "wrangler rollback",
    "audit": "bun audit",
    "ci": "bun run lint && bun run check && bun run test && bun run build && bun run audit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@opennextjs/cloudflare": "1.20.6",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "wrangler": "4.135.0"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "postcss": "8.5.26",
    "sharp": "0.35.4",
    "undici": "7.29.0"
  }
}
