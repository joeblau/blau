<section class="hero" id="top">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow rise rise-1">Agentic Development Environment</p>
      <h1 class="display rise rise-2">
        Your Mac is the cockpit.<br />
        <span class="display--muted">Your devices are the crew.</span>
      </h1>
      <p class="lead rise rise-3">
        blau unites agent-grade terminals, editing, previews, and GitHub in one
        native macOS window — then turns your iPhone, iPad, and Watch into
        encrypted control surfaces. Native. Private. Yours.
      </p>
      <div class="hero__cta rise rise-4">
        <a class="btn btn--primary" href="https://github.com/joeblau/blau" rel="noopener">
          Get started
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12h16M13 5l7 7-7 7" />
          </svg>
        </a>
        <a class="btn btn--ghost" href="#features">
          Explore the cockpit
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v16M5 13l7 7 7-7" />
          </svg>
        </a>
      </div>
    </div>
    <div class="hero__visual rise rise-3">
      <div class="terminal" role="img" aria-label="A Pilot terminal session running a coding agent, mirroring to Plotter, and binding a Wingman gesture">
        <div class="terminal__bar">
          <span class="terminal__dot terminal__dot--r"></span>
          <span class="terminal__dot terminal__dot--y"></span>
          <span class="terminal__dot terminal__dot--g"></span>
          <span class="terminal__title">pilot — agent session</span>
        </div>
        <div class="terminal__body">
          <div class="terminal__line">
            <span class="terminal__prompt">❯</span>
            <span data-typer></span>
            <span class="terminal__caret" aria-hidden="true"></span>
          </div>
          <div class="terminal__out" data-term-out></div>
        </div>
      </div>
    </div>
  </div>
</section>

